# Arquivos de ambiente (contêm informações sensíveis)
.env
.env.*
!.env.example

# Logs
*.log
storage/logs/*
!storage/logs/.gitkeep

# Cache e arquivos temporários
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/public/*
!storage/framework/cache/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/views/.gitkeep
!storage/app/public/.gitkeep

# Dependências de desenvolvimento
node_modules/
vendor/
!vendor/.gitkeep

# Arquivos de build locais
npm-debug.log*
yarn-debug.log*
yarn-error.log*
worker.log
ocr.log
schedule.log
pulse-check.log
pulse-check_error.log
ocr-worker-request.log
ocr-worker-request_error.log

# Arquivos do sistema
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore
.gitattributes

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Scripts de deployment
*.sh
!docker/docker-entrypoint.sh

# Testes
tests/
phpunit.xml
.phpunit.result.cache

# Outros arquivos de configuração de desenvolvimento
.editorconfig
.styleci.yml
README.md
CHANGELOG.md
LICENSE

# Arquivos específicos do projeto
supervisord.pid
supervisord.log
worker.log
queue-work.yaml
schedule-run.yaml
