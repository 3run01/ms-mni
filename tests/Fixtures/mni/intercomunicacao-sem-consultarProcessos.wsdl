<?xml version="1.0" encoding="UTF-8"?>
<!--
    WSDL reduzido do serviço de intercomunicação MNI 2.2.2, só para testes.
    Tribunal sem consultarProcessos: declara apenas consultarProcesso.
    O endpoint é fictício e nunca é chamado: os testes só leem as operações.
-->
<wsdl:definitions
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://www.cnj.jus.br/servico-intercomunicacao-2.2.2/"
    xmlns:tip="http://www.cnj.jus.br/tipos-servico-intercomunicacao-2.2.2"
    name="servico-intercomunicacao-2.2.2"
    targetNamespace="http://www.cnj.jus.br/servico-intercomunicacao-2.2.2/">

    <wsdl:types>
        <xsd:schema targetNamespace="http://www.cnj.jus.br/tipos-servico-intercomunicacao-2.2.2" elementFormDefault="qualified">
            <xsd:complexType name="tipoDocumento">
                <xsd:sequence>
                    <xsd:element name="conteudo" type="xsd:base64Binary" minOccurs="0"/>
                    <xsd:element name="documentoVinculado" type="tip:tipoDocumento" minOccurs="0" maxOccurs="unbounded"/>
                </xsd:sequence>
                <xsd:attribute name="idDocumento" type="xsd:string"/>
                <xsd:attribute name="mimetype" type="xsd:string"/>
                <xsd:attribute name="tipoDocumento" type="xsd:string"/>
                <xsd:attribute name="dataHora" type="xsd:string"/>
                <xsd:attribute name="descricao" type="xsd:string"/>
            </xsd:complexType>

            <xsd:complexType name="tipoProcessoJudicial">
                <xsd:sequence>
                    <xsd:element name="documento" type="tip:tipoDocumento" minOccurs="0" maxOccurs="unbounded"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:element name="consultarProcesso">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="idConsultante" type="xsd:string"/>
                        <xsd:element name="senhaConsultante" type="xsd:string"/>
                        <xsd:element name="numeroProcesso" type="xsd:string"/>
                        <xsd:element name="incluirCabecalho" type="xsd:boolean" minOccurs="0"/>
                        <xsd:element name="incluirMovimentos" type="xsd:boolean" minOccurs="0"/>
                        <xsd:element name="incluirDocumentos" type="xsd:boolean" minOccurs="0"/>
                        <xsd:element name="documento" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="consultarProcessoResposta">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="sucesso" type="xsd:boolean"/>
                        <xsd:element name="mensagem" type="xsd:string"/>
                        <xsd:element name="processo" type="tip:tipoProcessoJudicial" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:schema>
    </wsdl:types>

    <wsdl:message name="consultarProcesso">
        <wsdl:part name="parameters" element="tip:consultarProcesso"/>
    </wsdl:message>
    <wsdl:message name="consultarProcessoResposta">
        <wsdl:part name="parameters" element="tip:consultarProcessoResposta"/>
    </wsdl:message>

    <wsdl:portType name="servico-intercomunicacao-222">
        <wsdl:operation name="consultarProcesso">
            <wsdl:input message="tns:consultarProcesso"/>
            <wsdl:output message="tns:consultarProcessoResposta"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="servico-intercomunicacao-222SOAP" type="tns:servico-intercomunicacao-222">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="consultarProcesso">
            <soap:operation soapAction=""/>
            <wsdl:input><soap:body use="literal"/></wsdl:input>
            <wsdl:output><soap:body use="literal"/></wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="servico-intercomunicacao-2.2.2">
        <wsdl:port name="servico-intercomunicacao-222SOAP" binding="tns:servico-intercomunicacao-222SOAP">
            <soap:address location="https://mni.tribunal.exemplo/pje/intercomunicacao"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
