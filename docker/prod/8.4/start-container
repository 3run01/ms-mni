#!/usr/bin/env bash

if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "sail" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'sail' or 'root'."
    exit 1
fi

if [ ! -z "$WWWUSER" ]; then
    usermod -u $WWWUSER sail 2>/dev/null || true
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

chmod -R ugo+rw /.composer

# Garantir git safe directory para o usuário atual
git config --global --add safe.directory /var/www/html 2>/dev/null || true

# Give sail sudo permissions for elevated operations
if ! sudo -l &>/dev/null; then
    echo "sail ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers 2>/dev/null || true
fi

# Garantir permissões de escrita no storage e bootstrap/cache
mkdir -p /var/www/html/storage/logs \
         /var/www/html/storage/framework/cache/data \
         /var/www/html/storage/framework/sessions \
         /var/www/html/storage/framework/views \
         /var/www/html/storage/app/public/downloads \
         /var/www/html/bootstrap/cache
chown -R sail:sail /var/www/html/storage /var/www/html/bootstrap/cache
chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache

# Limpar cache de pacotes descobertos antes de iniciar (remove referências a pacotes dev não instalados)
if [ "$SUPERVISOR_PHP_USER" = "sail" ]; then
    su-exec sail rm -f /var/www/html/bootstrap/cache/packages.php /var/www/html/bootstrap/cache/services.php 2>/dev/null || true
else
    rm -f /var/www/html/bootstrap/cache/packages.php /var/www/html/bootstrap/cache/services.php 2>/dev/null || true
fi

# Executar migrations
if [ "$SUPERVISOR_PHP_USER" = "sail" ]; then
    su-exec sail php /var/www/html/artisan migrate --force
else
    php /var/www/html/artisan migrate --force
fi

if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec su-exec sail "$@"
    fi
else
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
